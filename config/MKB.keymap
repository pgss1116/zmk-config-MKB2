// #include <layout_shift.dtsi>

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define FUNC 1
#define NUM 2
#define MOUSE 3
#define SCROLL 4
#define BT 5

#define JP_YEN          0x89              // ¥
#define JP_PIPE         LS(0x89)          // |
#define JP_UNDERSCORE   LS(0x87)          // _

#define ZMK_POINTING_DEFAULT_SCRL_VAL 60

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
     behaviors {
       encoder_msc_down_up: encoder_msc_down_up {
           compatible = "zmk,behavior-sensor-rotate";
           label = "ENCODER_MSC_DOWN_UP";
           #sensor-binding-cells = <0>;
           bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
           tap-ms = <20>;
       };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp ESC    &kp Q     &kp W      &kp E     &kp R             &kp T            &kp Y        &kp U                     &kp I      &kp O      &kp P      &kp BACKSPACE
&kp TAB    &kp A     &kp S      &lt 2 D   &lt 1 F           &kp G            &kp H        &lt 1 J                   &lt 2 K    &kp L      &kp SEMI   &kp APOS
&kp LSHFT  &kp Z     &kp X      &kp C     &kp V             &kp B            &kp N        &kp M                     &kp COMMA  &kp DOT    &kp SLASH  &kp LEFT_SHIFT
&trans     &kp LGUI  &kp LALT             &kp LEFT_CONTROL  &lt 6 SPACE      &lt 6 ENTER  &mt LEFT_SHIFT BACKSPACE             &trans     &trans     &trans
&kp LEFT   &kp UP    &kp SPACE  &kp DOWN  &kp RIGHT                                       &kp HOME                  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                &kp A                                                                               &kp B
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&trans    &trans  &trans     &kp UP_ARROW    &trans     &trans      &trans  &kp N7    &kp N8     &kp N9     &kp DEL    &trans
&trans    &trans  &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &trans      &trans  &kp N4    &kp N5     &kp N6     &kp INS    &trans
&trans    &trans  &trans     &trans          &trans     &trans      &kp N0  &kp N1    &kp N2     &kp N3     &trans     &trans
&trans    &trans  &trans                     &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN        &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                                    &kp B
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        num_layer {
            label = "Num";
            bindings = <
&trans    &trans  &trans     &kp PG_UP      &trans     &trans      &trans  &kp F7    &kp F8     &kp F9     &trans     &trans
&trans    &trans  &kp HOME   &kp PAGE_DOWN  &kp END    &trans      &trans  &kp F4    &kp F5     &kp F6     &trans     &trans
&trans    &trans  &trans     &trans         &trans     &trans      &trans  &kp F10   &kp F2     &kp F3     &trans     &trans
&trans    &trans  &trans                    &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN       &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                                   &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &mkp MB5  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &mkp MB4  &mkp MB1  &mkp MB3   &mkp MB2   &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans    &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans    &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                        &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                                &kp B
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        scroll_layer {
            label = "Scr";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &mkp MB1  &mkp MB3   &mkp MB2   &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                              &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &bt BT_CLR_ALL  &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans                      &trans        &trans            &trans          &trans               &trans     &trans     &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                                       &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                        &kp A                                                                   &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        layer_6 {
            bindings = <
&trans  &trans            &trans            &trans            &trans            &trans                &trans            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH     &kp EQUAL  &trans
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)      &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)   &kp LS(NUMBER_9)  &kp MINUS  &trans
&trans  &trans            &trans            &trans            &trans            &trans                &trans            &kp JP_YEN        &kp JP_UNDERSCORE  &kp SEMICOLON     &kp APOS   &trans
&trans  &trans            &trans                              &trans            &trans                &kp GRAVE         &trans                               &trans            &trans     &trans
&trans  &trans            &trans            &trans            &trans                                                    &trans            &trans             &trans            &trans     &trans
                                            &trans                                                                                        &trans
            >;
        };
    };
};
